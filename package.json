{
  "name": "lyric-romanizer",
  "version": "0.3.1",
  "description": "Script detection and local romanization engine for lyrics — supports Japanese, Chinese, Korean, Cyrillic, Indic scripts, Tamil, Thai, and more",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./detector": {
      "types": "./dist/detector.d.ts",
      "import": "./dist/detector.js",
      "default": "./dist/detector.js"
    },
    "./dict": {
      "types": "./dist/dict.d.ts",
      "import": "./dist/dict.js",
      "default": "./dist/dict.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "verify": "pnpm run typecheck && pnpm run build && pnpm test && pnpm run smoke"
  },
  "dependencies": {
    "@dehoist/romanize-thai": "^1.0.0",
    "@indic-transliteration/sanscript": "^1.3.3",
    "@romanize/korean": "^0.1.3",
    "@sglkc/kuroshiro": "^1.0.1",
    "@sglkc/kuroshiro-analyzer-kuromoji": "^1.0.1",
    "cyrillic-to-translit-js": "^3.2.1",
    "pinyin-pro": "^3.28.2",
    "tamil-romanizer": "^1.0.2",
    "to-jyutping": "^3.1.1",
    "transliteration": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "romanization",
    "romanize",
    "lyrics",
    "pinyin",
    "kuroshiro",
    "korean",
    "cyrillic",
    "tamil",
    "thai",
    "devanagari",
    "transliteration",
    "script-detection"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/thedavidweng/lyric-romanizer.git"
  },
  "bugs": {
    "url": "https://github.com/thedavidweng/lyric-romanizer/issues"
  },
  "homepage": "https://github.com/thedavidweng/lyric-romanizer#readme",
  "packageManager": "pnpm@10.33.3"
}
